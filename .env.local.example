# ─────────────────────────────────────────────
#  SuiteMigrate — Environment Variables Template
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── APP ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SuiteMigrate

# ── SUPABASE ─────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── GEMINI AI ────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Non-experimental model required in production (names containing "-exp" are rejected)
GEMINI_MODEL=gemini-1.5-flash
# Fallback model used after repeated 503s
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# ── CHROME EXTENSION ────────────────────────
# Set to the extension's Chrome Web Store ID after publication
# Used by CORS to allow only your specific extension to call the API
# Leave blank during development — dev builds allow any chrome-extension:// origin
EXTENSION_ID=

# ── RAZORPAY ─────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay Plan IDs (create in Razorpay Dashboard → Products → Plans)
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_TEAM_MONTHLY=plan_xxxxxxxxxxxx

# ── EMAIL (Resend) ───────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# ── RATE LIMITING (Upstash Redis) ────────────
# Get from: https://upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── ANALYTICS (PostHog) ──────────────────────
# Get from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────
# SETUP CHECKLIST
# ─────────────────────────────────────────────
# [ ] Create Supabase project at supabase.com
# [ ] Enable Google OAuth in Supabase Auth settings
# [ ] Get Gemini API key from Google AI Studio (free)
# [ ] Create Razorpay account (need PAN/GST for India)
# [ ] Create 3 plans in Razorpay: Pro Monthly, Team Monthly, Lifetime
# [ ] Create Resend account and verify your domain
# [ ] Create Upstash Redis database (free tier)
# [ ] Replace all placeholder values above
# ─────────────────────────────────────────────
