# ─────────────────────────────────────────────
#  SuiteMigrate — Environment Variables Template
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── APP ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SuiteMigrate

# ── SUPABASE ─────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── AI CONVERSION SERVICE ────────────────────
# Keep provider credentials and production model choices private.
GEMINI_API_KEY=your_ai_service_api_key_here
GEMINI_MODEL=your_primary_model_name_here
GEMINI_FALLBACK_MODEL=your_fallback_model_name_here

# ── CHROME EXTENSION ────────────────────────
# Upload a Chrome Web Store draft first, copy the stable extension ID,
# then set it here BEFORE reviewer testing/submission.
# Used by CORS to allow only your specific extension to call the API.
# This Store item ID is public and safe to commit; override only for a different Store item.
EXTENSION_ID=ohdcofhfnjahaoblipdcpflainibhcld

# ── RAZORPAY ─────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay subscription Plan ID for Pro ($29/month, USD).
# Lifetime ($299) is created as a one-time Razorpay order, not a Plan.
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxxxxxxxxx

# ── EMAIL (Resend) ───────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# ── RATE LIMITING (Upstash Redis) ────────────
# Get from: https://upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── ANALYTICS (PostHog) ──────────────────────
# Get from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────
# SETUP CHECKLIST
# ─────────────────────────────────────────────
# [ ] Create Supabase project at supabase.com
# [ ] Enable Google OAuth in Supabase Auth settings
# [ ] Configure the AI conversion service credentials
# [ ] Create Razorpay account (need PAN/GST for India)
# [ ] Create the Razorpay Pro Monthly plan at $29/month USD
# [ ] Create Resend account and verify your domain
# [ ] Create Upstash Redis database (free tier)
# [ ] Replace all placeholder values above
# ─────────────────────────────────────────────
