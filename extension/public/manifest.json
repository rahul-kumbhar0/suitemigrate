{
  "manifest_version": 3,
  "name": "SuiteMigrate — SuiteScript 2.1 Migrator",
  "short_name": "SuiteMigrate",
  "version": "1.0.0",
  "description": "Scan your NetSuite account and automatically convert SuiteScript 1.0/2.0 scripts to 2.1 before the 2028 deadline.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SuiteMigrate"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.app.netsuite.com/*",
        "https://*.netsuite.com/*",
        "https://*.suitetapp.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://suitemigrate.vercel.app/*",
        "https://suitemigrate.com/*"
      ],
      "js": ["website.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://*.app.netsuite.com/*",
    "https://*.netsuite.com/*",
    "https://*.suitetapp.com/*",
    "http://localhost:3000/*",
    "https://suitemigrate.vercel.app/*",
    "https://suitemigrate.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
